#!/bin/sh
set -eu
action=${1:?Expected a declared check action}
case "$action" in check|lint|test|build) ;; *) exit 2 ;; esac
export GEM_HOME=/scratch/gems GEM_PATH=/scratch/gems:/usr/local/bundle
export PATH="/scratch/gems/bin:$PATH" BUNDLE_PATH=/scratch/bundle BUNDLE_APP_CONFIG=/scratch/bundle-config
mkdir -p /scratch/gems /scratch/bundle /scratch/bundle-config
gem install bundler --version 4.0.13 --no-document >&2
BUNDLE_FROZEN=true bundle _4.0.13_ install >&2
if [ "$action" = check ] || [ "$action" = lint ]; then
    for script in tests/container/stock tests/container/check-stock tests/container/test-publish; do bash -n "$script"; done
    for script in tests/container/ruby tests/container/markdown; do sh -n "$script"; done
fi
if [ "$action" = check ] || [ "$action" = lint ]; then
    bash tests/container/test-publish
    bundle exec rake rubocop
    bundle exec rake sorbet
fi
if [ "$action" = check ] || [ "$action" = test ]; then
    bundle exec rake test
fi
if [ "$action" = check ] || [ "$action" = build ]; then
    result=0
    bundle exec rake build || result=$?
    if [ "$action" = build ]; then
        if [ "$result" = 0 ]; then cp pkg/*.gem /outputs/ || result=$?; fi
        find /outputs -mindepth 1 -type d -exec chmod a+rwx {} +
    fi
    [ "$result" = 0 ] || exit "$result"
fi
