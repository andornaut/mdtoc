#!/bin/sh
set -eu

category=${1:-check}
[ "$#" -eq 0 ] || shift
case "$category" in
    check)
        for task in ${CHECK_TASKS:?CHECK_TASKS is required}; do
            "$0" "$task"
        done
        ;;
    lint)
        bundle exec rubocop
        bundle exec srb tc
        markdownlint-cli2
        ;;
    test)
        exec bundle exec ruby -w -Ilib:test -e 'Dir.glob("test/**/test_*.rb").sort.each { |file| require File.expand_path(file) }' -- "$@"
        ;;
    build)
        mkdir -p pkg
        version=$(bundle exec ruby -Ilib -rmdtoc/version -e 'print Mdtoc::VERSION')
        bundle exec gem build mdtoc.gemspec --output "pkg/mdtoc-${version}.gem"
        ;;
    exec)
        cp -R --no-preserve=ownership /opt/bundle /scratch/bundle
        export GEM_HOME=/scratch/gems GEM_PATH=/scratch/gems:/usr/local/bundle
        export BUNDLE_PATH=/scratch/bundle PATH=/scratch/gems/bin:$PATH
        mkdir -p "$GEM_HOME"
        if [ "$#" -gt 0 ]; then
            exec "$@"
        fi
        exec sh -ec "${COMMAND:?COMMAND is required}"
        ;;
    *)
        printf 'No %s check declared\n' "$category" >&2
        exit 2
        ;;
esac
